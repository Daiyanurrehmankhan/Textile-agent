# Neon connection string. Get it from your Neon project dashboard -> Connection Details.
# Keep sslmode=require -- Neon requires TLS.
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# Google API key for the LangGraph delay-investigation agent (Gemini). Get one
# at https://aistudio.google.com/apikey. Required to run the agent live --
# tests that need it skip themselves when this is unset.
GOOGLE_API_KEY=AI...

# Optional: override the Gemini model used by the agent (default: gemini-3.5-flash).
# GOOGLE_MODEL=gemini-3.5-flash

# Optional: comma-separated backup models tried in order if GOOGLE_MODEL's call
# fails (rate limit, quota, outage, ...). Default: gemini-3.6-flash, gemini-3.5-flash-lite
# (gemini-2.5-flash was dropped -- it 404s on this account's key despite being
# listed as live on Google's docs; your account may differ).
# GOOGLE_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Optional: per-path safety cap on tool calls per investigation (default: 6 for
# delay, 7 for mismatch -- the mismatch path more often wants one extra
# verification call, e.g. a broad inventory sweep, than a clean delay run needs).
# MAX_TOOL_CALLS_DELAY=6
# MAX_TOOL_CALLS_MISMATCH=7
